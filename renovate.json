{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "bump",
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/release\\.yml$/"
      ],
      "matchStrings": [
        "uses: release-plz/action@[^\\n]+\\n\\s+with:\\n\\s+command: \\S+\\n\\s+version: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "release-plz",
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/release-artifacts\\.yml$/"
      ],
      "matchStrings": [
        "cargo install cargo-cyclonedx --version (?<currentValue>\\S+) --locked"
      ],
      "depNameTemplate": "cargo-cyclonedx",
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/ci\\.yml$/"
      ],
      "matchStrings": [
        "cargo install cargo-deny --version (?<currentValue>\\S+) --locked"
      ],
      "depNameTemplate": "cargo-deny",
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/(ci|release|release-artifacts)\\.yml$/",
        "/^Dockerfile\\.(alpine|debian)$/",
        "/^nix\\/package\\.nix$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "tool: bpf-linker@(?<currentValue>\\S+)",
        "cargo binstall bpf-linker@(?<currentValue>\\S+)",
        "aya-rs/bpf-linker/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/",
        "pname = \"bpf-linker\";\\n\\s+version = \"(?<currentValue>[^\"]+)\";"
      ],
      "depNameTemplate": "bpf-linker",
      "packageNameTemplate": "aya-rs/bpf-linker",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "rust dependencies",
      "matchUpdateTypes": [
        "!lockFileMaintenance"
      ]
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "branchTopic": "cargo-lock-maintenance",
      "commitMessageTopic": "Cargo.lock"
    },
    {
      "matchManagers": [
        "nix"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "branchTopic": "flake-lock-maintenance",
      "commitMessageTopic": "flake.lock"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "prCreation": "not-pending",
      "internalChecksFilter": "strict"
    },
    {
      "matchDepNames": [
        "bpf-linker"
      ],
      "automerge": false,
      "prBodyNotes": [
        "Update the bpf-linker release SHA-256 in `Dockerfile.alpine`, `Dockerfile.debian` and `nix/package.nix` before merging, and check it supports the LLVM version of the pinned eBPF nightly (`EBPF_TOOLCHAIN` in `build.rs`)."
      ]
    }
  ]
}
