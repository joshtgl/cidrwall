# syntax=docker/dockerfile:1

FROM rust:1.99-trixie AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libmnl-dev libnftnl-dev pkg-config zstd \
    && rustup toolchain install nightly-2026-10-17 --profile minimal --component rust-src \
    && curl -fsSL https://github.com/aya-rs/bpf-linker/releases/download/v0.11.1/bpf-linker-x86_64-unknown-linux-musl.tar.zst -o /tmp/bpf-linker.tar.zst \
    && echo "e058a6aecc9e65fa4c977b298a8e4b738424d7629769fd352eed409fb57e16e8  /tmp/bpf-linker.tar.zst" | sha256sum -c - \
    && tar -xpf /tmp/bpf-linker.tar.zst -C /usr/local/bin \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY Cargo.toml Cargo.lock ./
COPY build.rs ./
COPY cidrwall-common ./cidrwall-common
COPY cidrwall-ebpf ./cidrwall-ebpf
COPY src ./src

RUN cargo build --locked --release --bin cidrwall

FROM debian:trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libmnl0 libnftnl11 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/target/release/cidrwall /usr/local/bin/cidrwall
COPY config/cidrwall.toml /etc/cidrwall/cidrwall.toml

ENTRYPOINT ["cidrwall"]
